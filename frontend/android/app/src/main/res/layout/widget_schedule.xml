<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top">

    <!-- White rounded box fills the whole widget footprint (match_parent) so the
         widget's touch area equals what you see. Card count adapts to the real
         height (cardCountForHeight) and applyBoxPadding centers the cards with an
         equal inset on all four sides. -->
    <LinearLayout
        android:id="@+id/widget_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="@dimen/widget_padding"
        android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_card_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_card_height"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:background="@drawable/widget_card_grad_0"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_name_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:drawablePadding="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E0FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:drawableStart="@drawable/ic_widget_clock"
                android:drawablePadding="4dp" />

            <TextView
                android:id="@+id/widget_location_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#E0FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="10dp"
                android:drawableStart="@drawable/ic_widget_map_pin"
                android:drawablePadding="4dp"
                android:visibility="gone" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_progress_1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FFFFFFFF"
            android:progressBackgroundTint="#40FFFFFF"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_card_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_card_height"
