<?xml version="1.0" encoding="utf-8"?>
<!-- Large widget — FULL SCREEN WIDTH, tall. No android:resizeMode => not resizable.
     minHeight kept ~250dp so the launcher's legacy cell math doesn't demand more
     rows than the grid has (which previously hid this widget from the picker);
     targetCellHeight=4 makes it tall on Android 12+. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:updatePeriodMillis="1800000"
    android:minWidth="300dp"
    android:minHeight="250dp"
    android:targetCellWidth="5"
    android:targetCellHeight="4"
    android:initialLayout="@layout/widget_schedule"
    android:widgetCategory="home_screen" />
