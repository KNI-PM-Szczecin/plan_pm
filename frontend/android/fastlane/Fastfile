require 'fileutils'

default_platform(:android)

def read_changelog_locale(version, locale)
  changelog = File.read("../../CHANGELOG.md")
  version_match = changelog.match(/^## #{Regexp.escape(version)}\n(.*?)(?=\n^## |\z)/m)
  return "Bug fixes and improvements" unless version_match
  locale_match = version_match[1].match(/^### #{Regexp.escape(locale)}\n(.*?)(?=\n^### |\z)/m)
  locale_match ? locale_match[1].strip : "Bug fixes and improvements"
end

# The APK attached to the GitHub release. Deliberately the universal APK Google
# generates from the uploaded bundle, not a local `flutter build apk`: Play App
# Signing re-signs the app with Google's key, so a locally built APK carries the
# upload key instead and cannot be installed over the Play Store version (nor
# the other way round) without uninstalling and losing the user's settings.
#
# Never fails the lane — by now the release is already on Play. A missing file
# is what the Jenkins release stage reports, as an unstable build.
def download_play_apk(version_name, version_code)
  destination = File.expand_path("../../build/app/outputs/universal-apk/plan_pm-#{version_name}.apk")
  FileUtils.rm_f(destination)

  # Play generates the APK while it processes the bundle, so it can lag the
  # upload by a minute or two; until then the API answers with an error.
  attempts = 10
  attempts.times do |i|
    begin
      download_universal_apk_from_google_play(
        package_name: "com.piotrwittig.plan_pm",
        version_code: version_code.to_i,
        json_key_data: ENV["PLAY_STORE_JSON_KEY"],
        destination: destination,
      )
      return
    rescue => e
      UI.important("Universal APK not available yet (attempt #{i + 1}/#{attempts}): #{e.message}")
      sleep(30) if i + 1 < attempts
    end
  end
  UI.important("Gave up on the universal APK for #{version_name} (#{version_code}); the GitHub release will be missing.")
end

platform :android do
  desc "Deploy a new version to the Google Play"
  lane :deploy do
    # Write key.properties from env vars for release signing
    key_props = [
      "storePassword=#{ENV["ANDROID_KEYSTORE_PASSWORD"]}",
      "keyPassword=#{ENV["ANDROID_KEY_PASSWORD"]}",
      "keyAlias=#{ENV["ANDROID_KEY_ALIAS"]}",
      "storeFile=../upload-keystore.jks",
    ].join("\n")
    File.write("../../android/key.properties", key_props)

    sh("cd ../../ && flutter build appbundle --release")

    pubspec = YAML.load_file("../../pubspec.yaml")
    version_name = pubspec["version"].split("+").first

    # Play Store expects changelogs as files under metadata/android/<locale>/changelogs/<version_code>.txt
    version_code = pubspec["version"].split("+").last
    {
      "pl-PL" => read_changelog_locale(version_name, "pl-PL"),
      "en-US" => read_changelog_locale(version_name, "en-US"),
    }.each do |locale, notes|
      dir = "metadata/android/#{locale}/changelogs"
      FileUtils.mkdir_p(dir)
      File.write("#{dir}/#{version_code}.txt", notes)
    end

    # See the iOS lane: lets a new CI machine exercise the signing chain
    # without consuming a version code Play will not accept twice.
    if ENV["PLANPM_SKIP_UPLOAD"] == "true"
      UI.important("PLANPM_SKIP_UPLOAD is set — built and signed #{version_name} (#{version_code}), not uploading to Google Play.")
      next
    end

    upload_to_play_store(
      track: "production",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["PLAY_STORE_JSON_KEY"],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )

    download_play_apk(version_name, version_code)
  end

  desc "Promote internal build to production"
  lane :promote do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      json_key_data: ENV["PLAY_STORE_JSON_KEY"],
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
