<?xml version="1.0" encoding="UTF-8"?>
<university>
    <faculty name="Wydział Informatyki i Telekomunikacji">
        <degree_course name="Informatyka">
            <specialisation>Programowanie systemów informatycznych</specialisation>
            <specialisation>Programowanie systemów multimedialnych</specialisation>
            <specialisation>Sztuczna Inteligencja</specialisation>
        </degree_course>
        <degree_course name="Teleinformatyka">
            <specialisation>Cyberbezpieczeństwo</specialisation>
            <specialisation>Eksploatacja systemów łączności</specialisation>
        </degree_course>
    </faculty>

    <faculty name="Wydział Geoinżynierii i Ochrony Środowiska">
